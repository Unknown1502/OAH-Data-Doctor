# Copy to .env and adjust. Never commit .env.
# FHIR server (read-only access; Data Doctor only issues GET and $validate)
DD_FHIR_BASE=https://sandbox.hl7europe.eu/oneaquahealth/fhir
# auto = live with verified-snapshot fallback | live | snapshot
DD_SOURCE=auto
# DD_SNAPSHOT_ID=2026-09-30T09-08-55Z
DD_HTTP_DELAY_S=0.25
# Optional language model: rephrases already-computed findings and fills gaps when reading a typed claim.
# It never detects problems or decides verdicts. The product works fully with "none" (the default).
DD_LLM_PROVIDER=none
#
# Free and local (recommended): install Ollama (https://ollama.com), run `ollama pull qwen2.5:3b`, then:
# DD_LLM_PROVIDER=ollama
# DD_LLM_MODEL=qwen2.5:3b
# DD_LLM_BASE_URL=http://localhost:11434
#
# Free hosted tier of any OpenAI-compatible endpoint (Groq shown; Gemini and OpenRouter work the same way):
# DD_LLM_PROVIDER=openai-compatible
# DD_LLM_BASE_URL=https://api.groq.com/openai/v1
# DD_LLM_MODEL=llama-3.1-8b-instant
# DD_LLM_API_KEY=
#
# Claude (paid): pip install ".[ai]", then
# DD_LLM_PROVIDER=anthropic
# DD_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
#
# DD_LLM_TIMEOUT_S=120
#
# Users can also bring their own provider and key from the UI ("Language model" at the top of every page). The key stays
# in their browser and is sent only with their own requests; the server never stores or logs it.
# DD_LLM_ALLOW_USER_KEYS=true
# Allow a free-form endpoint URL in that dialog (LM Studio, vLLM...). Keep false on a publicly hosted instance: otherwise
# any visitor could make the server send requests to arbitrary addresses.
# DD_LLM_ALLOW_CUSTOM_URL=false
