# Copy to .env and adjust. Never commit .env.
# FHIR server (read-only access; Data Doctor only issues GET and $validate)
DD_FHIR_BASE=https://sandbox.hl7europe.eu/oneaquahealth/fhir
# auto = live with verified-snapshot fallback | live | snapshot
DD_SOURCE=auto
# DD_SNAPSHOT_ID=2026-09-30T09-08-55Z
DD_HTTP_DELAY_S=0.25
# Optional plain-language explanations of already-computed findings. The product works fully with "none".
DD_LLM_PROVIDER=none
DD_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=
