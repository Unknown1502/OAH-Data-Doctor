  },
  "type": {
   "$ref": "#/$defs/ClaimType"
  },
  "year_from": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Year From"
  },
  "year_to": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
